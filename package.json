{
  "name": "@cb/env",
  "version": "0.0.0",
  "description": "CLI, local agent and preload for cb credentialless development environments",
  "type": "commonjs",
  "bin": {
    "cb": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "sync:contract": "node scripts/sync-contract.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@napi-rs/keyring": "^2.1.0",
    "commander": "^14.0.3",
    "cross-spawn": "^7.0.6",
    "server-only": "^0.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@peculiar/x509": "^2.1.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "mongodb": "^7.7.0",
    "mongodb-memory-server-core": "^11.3.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "browser": "./dist/api/browser-stub.js",
      "default": "./dist/api/index.js"
    },
    "./register": "./dist/register/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/api/index.js",
  "types": "./dist/api/index.d.ts"
}
